# Dependency directories
node_modules/

# Environmental variables (keeps your Discord token and client ID private)
.env

# Local SQLite data and temporary WAL files (runtime data must never be committed)
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system files
.DS_Store
Thumbs.db
